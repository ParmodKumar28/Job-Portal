<style>
  .bg-color {
    background-color: #181642;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  h1 {
    font-size: 6rem !important;
    margin-bottom: 20px;
  }

  p {
    font-size: 2.6rem !important;
    margin-bottom: 20px;
  }

  #back-btn {
    background-color: #47336e;
    color: white;
    padding: 12px 30px;
    margin-bottom: 1.2rem;
    border-radius: 5px;
    text-decoration: none;
    font-size: 1.5rem;
    display: inline-block;
    transition: background-color 0.3s ease;
  }

  #back-btn:hover {
    background-color: #5a3d8a;
  }

  .navbar-color {
    background-color: #47336e !important;
    box-shadow: 0px 1px 10px rgb(149 157 165 / 20%) !important;
  }

  /* Mobile-specific styles */
  @media (max-width: 576px) {
    #back-btn {
      font-size: 1.2rem;
      padding: 10px 20px;
    }
  }
</style>
<!--  -->

<div class="container-fluid bg-color">
  <div class="container text-center">
    <h1 class="display-4 text-light">
      OOPS!
      <img
        src="https://cdn.jsdelivr.net/gh/ahmedhosna95/upload@1731955f/sad404.svg"
        alt="Image"
      />
    </h1>
    <% if(errorMessage) { %>

    <p class="lead text-danger"><%= errorMessage %></p>
    <% } %>

    <a id="back-btn" href="/"> Go Back Homepage</a>
  </div>
</div>
